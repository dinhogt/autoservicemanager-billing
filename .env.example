NODE_ENV=development
PORT=3000
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=
DYNAMODB_TABLE=autoservicemanager-billing
SQS_COMMAND_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/billing-commands
SNS_EVENTS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:billing-events
SQS_POLLING_ENABLED=true
MERCADO_PAGO_BASE_URL=https://api.mercadopago.com
MERCADO_PAGO_ACCESS_TOKEN=replace-at-runtime
MERCADO_PAGO_WEBHOOK_SECRET=replace-at-runtime
WEBHOOK_SIGNATURE_ENABLED=true
